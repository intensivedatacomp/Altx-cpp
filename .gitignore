# vim
.swp

# Vim's compiled form of spell/en.utf-8.add. Generated from the committed word
# list, binary, and regenerated whenever that list is newer -- so committing it
# would only produce merge conflicts in a file nobody can read.
spell/*.spl

# VS Code. The shared settings live in .devcontainer/devcontainer.json and
# cspell.config.yaml, both of which are committed; this is the per-developer
# remainder.
.vscode

# Claude
CLAUDE.md

# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger Files
*.pdb

# Compiled Dynamic libraries
*.so
*.dylib
*.dll
*.so.*


# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Build directories
build/
Build/

# CMake generated files
# CMakePresets.json is committed -- it is the build matrix. This one is for
# personal configurations and is per-developer by design.
CMakeUserPresets.json
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
install_manifest.txt
compile_commands.json

# Temporary files
*.tmp
*.log
*.bak
*.swp

# vcpkg
vcpkg_installed/

# debug information files
*.dwo

# test output & cache
Testing/
.cache/

# Coverage report -- scripts/ci/coverage.sh writes the tracefile, the genhtml
# tree and the badge here. Only the badge is kept, and CI moves that to
# .badges/coverage.svg, which *is* committed.
coverage/

# Python bytecode -- scripts/ci/ imports across modules, so this appears there
__pycache__/
*.pyc

# Python tool caches -- the pre-commit hooks configured in pyproject.toml
.mypy_cache/
.ruff_cache/

# uv reads the root pyproject.toml as a project unless told --no-project, and
# drops a virtualenv and a lock file here when it does. Nothing is installed
# from this repository, so neither is a real artefact.
.venv/
uv.lock
